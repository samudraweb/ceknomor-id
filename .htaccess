# ----------------------------------------------------------------------
# Security Hardening for ceknomor.id
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to sensitive internal directories
    RewriteRule ^(config|sql|app|logs)/.* - [F,L]
    
    # 2. Block access to backup and source files (.bak, .sql, .sh, etc.)
    RewriteRule \.(bak|config|sql|sh|inc|md)$ - [F,L]

    # 3. Block access to hidden files and directories (.env, .git, .htaccess)
    # (Except for well-known challenges like Let's Encrypt)
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^\.|/\.) - [F,L]

    # 4. Remove .html extension
    # Redirect external .html requests to extensionless url
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
    RewriteRule ^(.*)\.html$ $1/ [R=301,L]

    # Add trailing slash if not a file and no trailing slash
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ $1/ [R=301,L]

    # Article SEO Route (e.g. /artikel/slug/)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^artikel/([^/]+)/$ artikel.php?slug=$1 [L,QSA]

    # Resolve extensionless URLs to .html files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)/$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
    # 4. Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# 5. Disable directory browsing
Options -Indexes

<IfModule mod_deflate.c>
    # Enable compression
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    # Enable expirations
    ExpiresActive On
    # Default directive
    ExpiresDefault "access plus 1 month"
    # CSS and JS
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    # Media: images, video, audio
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    # Webfonts
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
